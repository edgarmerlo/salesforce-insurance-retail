/**
 * @description Invocable action for Salesforce 360 Insurance Retail Agent.
 *              Executes storewide aggregate SOQL queries over Purchase__c records
 *              to provide the AI Agent with raw sales volume, order counts, top category revenue,
 *              and purchase categories currently uncovered by active insurance products.
 */
public with sharing class StoreTrendsAction {

    public class Request {
        @InvocableVariable(
            label='Category Filter' 
            description='Optional retail category to filter trends by (leave blank to analyze all store categories)' 
            required=false
        )
        public String categoryFilter;
    }

    public class Response {
        @InvocableVariable(
            label='Total Store Volume' 
            description='Total gross revenue from all purchases' 
            required=true
        )
        public Decimal totalStoreVolume;

        @InvocableVariable(
            label='Total Orders' 
            description='Total number of purchase orders across the store' 
            required=true
        )
        public Integer totalOrders;

        @InvocableVariable(
            label='Top Category' 
            description='The retail category with the highest revenue' 
            required=true
        )
        public String topCategory;

        @InvocableVariable(
            label='Top Category Revenue' 
            description='Total gross revenue generated by the top category' 
            required=true
        )
        public Decimal topCategoryRevenue;

        @InvocableVariable(
            label='Uncovered Categories' 
            description='Store categories present in sales that currently lack active insurance coverage offerings (e.g., Technology, Fashion, Home)' 
            required=true
        )
        public String uncoveredCategories;
    }

    /**
     * @description Invocable method to fetch aggregate store trends and uncovered insurance categories.
     * @param requests List of requests from Agentforce or Flow (may include optional categoryFilter)
     * @return List<Response> Aggregate store performance and category coverage metrics
     */
    @InvocableMethod(
        label='Get Store Trends' 
        description='Calculates storewide purchase aggregates, top performing category, and uncovered insurance categories' 
        category='Insurance Retail'
    )
    public static List<Response> getStoreTrends(List<Request> requests) {
        // Check for optional category filter from first request
        String filter = (requests != null && !requests.isEmpty() && String.isNotBlank(requests[0].categoryFilter))
            ? requests[0].categoryFilter.trim()
            : null;

        // 1. Execute aggregate SOQL grouped by category in user mode
        List<AggregateResult> aggResults;
        if (filter != null) {
            aggResults = [
                SELECT Category__c category, COUNT(Id) orderCount, SUM(Amount__c) totalAmount
                FROM Purchase__c
                WHERE Category__c = :filter
                WITH USER_MODE
                GROUP BY Category__c
                ORDER BY SUM(Amount__c) DESC
            ];
        } else {
            aggResults = [
                SELECT Category__c category, COUNT(Id) orderCount, SUM(Amount__c) totalAmount
                FROM Purchase__c
                WHERE Category__c != null
                WITH USER_MODE
                GROUP BY Category__c
                ORDER BY SUM(Amount__c) DESC
            ];
        }

        Decimal totalStoreVolume = 0.00;
        Integer totalOrders = 0;
        String topCategory = 'None';
        Decimal topCategoryRevenue = 0.00;

        // Categories covered by standard Cardholder Protection Plus policy (Travel, Sports)
        Set<String> coveredCategories = new Set<String>{ 'Travel', 'Sports' };
        List<String> uncoveredList = new List<String>();

        Boolean isFirst = true;
        for (AggregateResult ar : aggResults) {
            String category = (String) ar.get('category');
            Integer count = ar.get('orderCount') != null ? Integer.valueOf(ar.get('orderCount')) : 0;
            Decimal sumAmount = ar.get('totalAmount') != null ? (Decimal) ar.get('totalAmount') : 0.00;

            totalOrders += count;
            totalStoreVolume += sumAmount;

            if (isFirst) {
                topCategory = category != null ? category : 'None';
                topCategoryRevenue = sumAmount;
                isFirst = false;
            }

            if (String.isNotBlank(category) && !coveredCategories.contains(category)) {
                uncoveredList.add(category);
            }
        }

        Response res = new Response();
        res.totalStoreVolume = totalStoreVolume.setScale(2);
        res.totalOrders = totalOrders;
        res.topCategory = topCategory;
        res.topCategoryRevenue = topCategoryRevenue.setScale(2);
        res.uncoveredCategories = !uncoveredList.isEmpty() ? String.join(uncoveredList, ', ') : 'None';

        // Match input batch size so Agentforce receives a 1:1 response
        List<Response> responses = new List<Response>();
        Integer batchSize = (requests != null && !requests.isEmpty()) ? requests.size() : 1;
        for (Integer i = 0; i < batchSize; i++) {
            responses.add(res);
        }

        return responses;
    }
}
